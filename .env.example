# LinkedIn API (OAuth app — https://www.linkedin.com/developers/apps)
# --- Register these under the app: Auth → Authorized redirect URLs (exact match) ---
# http://localhost:3000/auth/linkedin/callback   ← used by npm run setup-linkedin-oauth (must match LINKEDIN_OAUTH_REDIRECT_URI below)
# https://www.linkedin.com/developers/tools/oauth/redirect   ← optional; LinkedIn’s OAuth playground only, not used by this repo
# ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must match one of the Authorized redirect URLs above (same string as in LinkedIn portal)
LINKEDIN_OAUTH_REDIRECT_URI=
# Updated after npm run setup-linkedin-oauth (tokens also in temp/linkedin-oauth-token.json)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_PERSON_URN=

# Google Gemini API (used for cheaper agent tasks)
