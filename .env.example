# AI Brief — local secrets template (copy to .env and fill in)
# NEVER commit .env — it is gitignored.

# OpenAI
OPENAI_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=

# Google Cloud / YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# LinkedIn (https://www.linkedin.com/developers/apps)
# Auth → Authorized redirect URLs must include:
#   http://localhost:3000/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback
# Filled by: cd discord-bot && npm run setup-linkedin-oauth
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_PERSON_URN=

# Google Gemini
GEMINI_API_KEY=

# Discord bot (server AB / AI Brief)
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Email (Gmail SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Drive (PDF review link)
GDRIVE_FOLDER_ID=
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REDIRECT_URI=
